
# ──────────────────────────────────────────────────────────────────────────────
#  Shadow Trust SOC Honeynet — Backend Environment
#  Copy this file to backend/.env and fill in your real values.
#  NEVER commit backend/.env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# --------------------------------------------------------------------------
# CORE CONFIGURATION
# --------------------------------------------------------------------------
PROJECT_NAME="Shadow Trust AI Honeypot"
API_V1_STR="/api/v1"
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# --------------------------------------------------------------------------
# DATABASE (MariaDB)
# --------------------------------------------------------------------------
# SQLAlchemy async URL. For a native `uvicorn` run this points at the MariaDB
# container on localhost; inside docker-compose the backend service overrides
# it to use host `db`. Credentials must match the root .env MARIADB_* values.
DATABASE_URL="mysql+aiomysql://shadowtrust:shadowtrust@localhost:3307/shadowtrust"

# --------------------------------------------------------------------------
# EMAIL SETTINGS (OPTIONAL — for OTP / alerts)
# --------------------------------------------------------------------------
# Using Gmail SMTP? Enable 2-FA and use an App Password (not your login password).
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-gmail-app-password"
MAIL_FROM="your-email@gmail.com"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_FROM_NAME="Shadow Trust Security"

# Credential Management System SMTP (mirrors the settings above)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="your-email@gmail.com"

# --------------------------------------------------------------------------
# WHATSAPP ALERTS (OPTIONAL — via Twilio)
# --------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM="+14155238886"

# --------------------------------------------------------------------------
# AWS (OPTIONAL — for EC2 VM orchestration & S3 log storage)
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""

# --------------------------------------------------------------------------
# GCP (OPTIONAL — future scope)
# --------------------------------------------------------------------------
GCP_PROJECT_ID=""
GCP_SERVICE_ACCOUNT_KEY=""

# ──────────────────────────────────────────────────────────────────────────────
#  INFRASTRUCTURE PROVIDER
# ──────────────────────────────────────────────────────────────────────────────
# 'local' (default) — labs run as Docker containers. Requires Docker only.
#                     No AWS account, no credentials, no cost.
# 'aws'             — labs run as EC2 instances. Requires the AWS block below.
INFRA_PROVIDER=local

# --- Local (Docker) provider settings -----------------------------------------
# Network shared by the backend, guacd and every lab container.
LAB_DOCKER_NETWORK=shadowtrust_labnet
LAB_IMAGE_KALI=shadowtrust/lab-kali:latest
LAB_KALI_USER=kali
LAB_KALI_PASSWORD=kali

# Windows labs: OFF by default. Linux host with /dev/kvm only — not macOS.
LAB_WINDOWS_ENABLED=false

# Guacamole. In docker-compose the backend sets these to the `guacamole_db` /
# `guacamole` service names; a native `./start.sh` run uses localhost.
# GUAC_DB_HOST=localhost
# GUAC_API_URL=http://localhost:8080/guacamole
GUAC_DB_PASSWORD=guacamole_password

# --- Telemetry ----------------------------------------------------------------
# Defaults to 'local' when INFRA_PROVIDER=local, 's3' when INFRA_PROVIDER=aws.
# TELEMETRY_SOURCE=local
TELEMETRY_DIR=./telemetry

# --- AWS provider settings (ONLY needed when INFRA_PROVIDER=aws) ---------------
# AWS_SUBNET_ID=""
# AWS_SECURITY_GROUP_ID=""
# AWS_IAM_PROFILE=""
# AWS_AMI_KALI=""
# AWS_AMI_WINDOWS=""
# AWS_AMI_WINDOWS_MALWARE=""
# Resource tier -> EC2 instance type
# AWS_INSTANCE_TYPE_LIGHT=t3.small
# AWS_INSTANCE_TYPE_STANDARD=t3.medium
# AWS_INSTANCE_TYPE_HEAVY=t3.xlarge

# ──────────────────────────────────────────────────────────────────────────────
#  Splunk Blue Team page
# ──────────────────────────────────────────────────────────────────────────────
# Splunk runs as a separate compose project (~/splunk-lab). Bring it up with
# `cd ~/splunk-lab && docker compose up -d`. Its web UI must be on 8009 (8000 is
# the Shadow Trust backend) and the management API 8089 must be published.
SPLUNK_API_URL=https://host.docker.internal:8089
SPLUNK_WEB_URL=http://localhost:8009
SPLUNK_USER=admin
SPLUNK_PASSWORD=ChangeMe123!

# ──────────────────────────────────────────────────────────────────────────────
#  Malware Lab (Binary Analysis)
# ──────────────────────────────────────────────────────────────────────────────
# ClamAV runs as the `clamav` service (arm64 via the -debian image). Optional:
# set a VirusTotal API key for a 70-engine second opinion (free tier: 4/min).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
VIRUSTOTAL_API_KEY=
