
# --------------------------------------------------------------------------
# CORE CONFIGURATION
# --------------------------------------------------------------------------
PROJECT_NAME="SentinelHive AI Honeypot"
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# --------------------------------------------------------------------------
# SUPABASE (REQUIRED)
# --------------------------------------------------------------------------
# Get these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-url.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

# --------------------------------------------------------------------------
# EMAIL SETTINGS (OPTIONAL - FOR OTP)
# --------------------------------------------------------------------------
# Using Gmail SMTP? Use App Password, not your login password.
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="your-email@gmail.com"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_FROM_NAME="SentinelHive Security"

# --------------------------------------------------------------------------
# CLOUD INTEGRATIONS (OPTIONAL - FUTURE SCOPE)
# --------------------------------------------------------------------------
# AWS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""

# GCP
GCP_PROJECT_ID=""
GCP_SERVICE_ACCOUNT_KEY=""
