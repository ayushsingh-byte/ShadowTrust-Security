# ──────────────────────────────────────────────────────────────────────────────
#  Shadow Trust SOC Honeynet — Root Docker Compose Variables
#  setup.sh creates .env from this automatically. Do not commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# Platform-specific — auto-detected by setup.sh
#   macOS / Windows Docker Desktop → host.docker.internal
#   Linux                          → 172.17.0.1
MOBSF_DOCKER_HOST=host.docker.internal

# Host port overrides (optional — change if ports collide on your machine)
BACKEND_PORT=8000
MOBSF_PORT=5055
NODE_API_PORT=3000
FRONTEND_PORT=5500
PHPMYADMIN_PORT=8081
MARIADB_PORT=3307

# ──────────────────────────────────────────────────────────────────────────────
#  Application database (MariaDB) — managed through phpMyAdmin at :8081
# ──────────────────────────────────────────────────────────────────────────────
# The backend builds its DATABASE_URL from MARIADB_USER/PASSWORD/DATABASE and
# connects to the `db` service. Change these before first boot — once the
# db_data volume is initialised the credentials are baked in until `down -v`.
MARIADB_ROOT_PASSWORD=shadowtrust_root
MARIADB_DATABASE=shadowtrust
MARIADB_USER=shadowtrust
MARIADB_PASSWORD=shadowtrust

# ──────────────────────────────────────────────────────────────────────────────
#  Infrastructure provider
# ──────────────────────────────────────────────────────────────────────────────
# 'local' (default) runs labs as Docker containers — no AWS account, no cost.
# 'aws'   runs labs as EC2 instances and requires AWS credentials below.
INFRA_PROVIDER=local

# ── VM Lab (vm_lab.html — Kali/Windows desktops via Guacamole) ────────────────
# Docker network shared by the backend, guacd and every lab container.
LAB_DOCKER_NETWORK=shadowtrust_labnet

# Kali lab image (built automatically by setup.sh / make labs-up; or: make lab-image)
LAB_IMAGE_KALI=shadowtrust/lab-kali:latest
LAB_KALI_USER=kali
LAB_KALI_PASSWORD=kali

# Windows labs: OFF by default. They only run on a Linux host with hardware
# virtualization (/dev/kvm) — macOS cannot run them at all. When true, the
# Docker provider launches dockurr/windows (downloads a Windows ISO on first run).
LAB_WINDOWS_ENABLED=false
LAB_IMAGE_WINDOWS=dockurr/windows

# Guacamole (remote-desktop broker). Its own Postgres, separate from MariaDB.
GUAC_PORT=8080
GUAC_DB_PASSWORD=guacamole_password

# ──────────────────────────────────────────────────────────────────────────────
#  Telemetry ingestion
# ──────────────────────────────────────────────────────────────────────────────
# Defaults to 'local' when INFRA_PROVIDER=local, 's3' when INFRA_PROVIDER=aws.
# Set explicitly to mix modes (e.g. local labs, cloud telemetry).
# TELEMETRY_SOURCE=local

# Directory watched for honeypot logs in local mode (newline-delimited JSON).
# Only read by a bare (non-Docker) `uvicorn app.main:app`. The containerized
# backend in docker-compose.yml always uses /app/telemetry/raw, which is the
# read-only bind mount of ./telemetry/raw — the same path the sensor
# containers write into. Point this at the same folder for a native run so
# both paths watch identical data.
TELEMETRY_DIR=./telemetry/raw

# Collector poll interval, in seconds. Lower = telemetry appears on the
# dashboard sooner after a sensor writes it; higher = less disk I/O tailing
# idle log files. 2s is responsive enough to feel live in a demo.
COLLECTOR_INTERVAL_SECONDS=2

# Origins allowed to call the API and open the SSE stream. Must include
# wherever the dashboard is actually served from — port 5500 covers the
# nginx frontend container; add your LAN IP here too if MacBook #2 will load
# the dashboard directly instead of just attacking the honeypots.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ──────────────────────────────────────────────────────────────────────────────
#  Honeypot sensor ports (host side)
# ──────────────────────────────────────────────────────────────────────────────
# What the SECOND MacBook connects to, e.g. `ssh -p 2222 root@<main-ip>`.
# Left at these non-privileged defaults so the honeypot never collides with a
# real sshd/ftpd on the host. Set HONEYPOT_SSH_PORT=22 for a bare
# `ssh root@<ip>` if nothing else on the host is listening on 22.
HONEYPOT_SSH_PORT=2222
HONEYPOT_TELNET_PORT=2223
HONEYPOT_HTTP_PORT=8022
HONEYPOT_ALT_PORT=8023
HONEYPOT_SMB_PORT=445
HONEYPOT_FTP_PORT=2121
HONEYPOT_MSSQL_PORT=1433

# ──────────────────────────────────────────────────────────────────────────────
#  Splunk Blue Team page (splunk.html)
# ──────────────────────────────────────────────────────────────────────────────
# Splunk runs as its own compose project: cd ~/splunk-lab && docker compose up -d
# Its web UI is on 8009 (8000 = Shadow Trust backend); mgmt API 8089 must be published.
SPLUNK_API_URL=https://host.docker.internal:8089
SPLUNK_WEB_URL=http://localhost:8009
SPLUNK_USER=admin
SPLUNK_PASSWORD=ChangeMe123!

# ──────────────────────────────────────────────────────────────────────────────
#  Malware Lab — antivirus engine (malware.html)
# ──────────────────────────────────────────────────────────────────────────────
# ClamAV runs in the main compose file (service "clamav"); these override the
# defaults only if you move it. First boot downloads ~1.5 GB of signatures.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Optional: cross-check file hashes against VirusTotal. Free key from
# virustotal.com -> profile -> API key. Left blank = ClamAV-only verdict.
VIRUSTOTAL_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
#  SOC hardening (task 12) — FAIL-CLOSED by default
# ──────────────────────────────────────────────────────────────────────────────
# /health status page. 0 = 404 (default). Even at 1 it emits NO secrets — the
# full operator detail (credentials, DB info, attack commands) is the
# authenticated GET /api/v1/admin/diagnostics (ADMIN role).
HEALTH_PAGE=0
# The dev_bypass_token auth shortcut + POST /auth/dev-bypass. Honoured only when
# this is 1 AND INFRA_PROVIDER=local. Any production-like config ignores it.
DEV_BYPASS=0

# ──────────────────────────────────────────────────────────────────────────────
#  Detection & correlation engine
# ──────────────────────────────────────────────────────────────────────────────
DETECTION_ENGINE_INTERVAL_SECONDS=20
# Malware quarantine + upload cap (task 11). Samples live in backend/quarantine/
# (git-ignored, never web-served); reachable only via the authed evidence-sample
# endpoint. Default 100 MB.
MAX_MALWARE_UPLOAD_BYTES=104857600

# ──────────────────────────────────────────────────────────────────────────────
#  Analysis Lab (analysis_lab.html) — disposable egress-free sandbox shells
# ──────────────────────────────────────────────────────────────────────────────
# Build the image first:  make analysis-image
ANALYSIS_IMAGE=shadowtrust/analysis-shell:latest
ANALYSIS_DOCKER_NETWORK=shadowtrust_analysis
ANALYSIS_SHELL_TTL_MIN=20
ANALYSIS_SHELL_MAX_SESSIONS=8

# ──────────────────────────────────────────────────────────────────────────────
#  Guacamole admin — CHANGE FROM THE DEFAULT
# ──────────────────────────────────────────────────────────────────────────────
# The guacamole_db image seeds guacadmin/guacadmin. Generate a strong password
# and run scripts/set_guac_password.sh (or the UPDATE in SETUP.md) after first boot.
GUAC_ADMIN_PASSWORD=
