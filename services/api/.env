# Fastify API
PORT=8000
HOST=0.0.0.0

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUD=authenticated
# Optional overrides:
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISS=https://YOUR_PROJECT.supabase.co/auth/v1

# Node registry (collector): JSON array of nodes
# Example:
# NODE_REGISTRY_JSON=[{"nodeId":"node-1","name":"EDGE-01","sqlitePath":"/var/lib/honeynet/node-1/telemetry.sqlite","region":"local"}]
NODE_REGISTRY_JSON=[]

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
