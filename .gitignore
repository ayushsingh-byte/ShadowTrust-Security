# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
wheelhouse/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Coverage
.coverage
coverage.xml
htmlcov/

# --- Environment / secrets ---
# .env files ARE committed intentionally (private repo, shared team credentials).
# ⚠  KEEP THIS REPO PRIVATE. Never make it public.
*.pem
*.key
*.p12
*.pfx

# --- Logs / runtime artifacts ---
*.log
logs/

# Common runtime scratch
*.pid
*.pid.lock

# --- Databases / local state ---
# The application database is MariaDB, running as the `db` container with its
# data in the db_data Docker volume — nothing DB-related lives in the repo now.
# Any stray *.db / SQLite sidecar files are leftovers and should not be committed.
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# Local scan outputs (runtime)
scans/*.json
backend/scans/
backend/reports/

# Stray duplicate env files (previously removed)

# --- Frontend / Node ---
node_modules/

# TypeScript / Node build caches
*.tsbuildinfo
.eslintcache
.parcel-cache/
.turbo/
.next/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Misc ---
*.swp
*.swo
*.tmp

# Malware analysis — quarantined samples & incident evidence, never committed
backend/quarantine/
backend/evidence/
backend/mobsf_service/data/uploads/

# Build/codex scratch, never committed
.codex-build/
.codex-finalizer/

# Analysis Lab seed filesystem — fake scenario content, must be tracked
!docker/analysis-seed/**
