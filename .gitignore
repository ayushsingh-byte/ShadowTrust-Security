# --- Environment / secrets — NEVER COMMIT .env ---
.env
*.env
!*.env.example
!.env.example
# The Analysis Lab seed filesystem intentionally contains decoy secrets for the
# secret-detector to find — it is test fixture data, not real credentials.
!docker/analysis-seed/**
.env.backup
*.pem
*.key
*.p12
*.pfx
backend/demo_keys.json
backend/.lab_state.json

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# Test / build / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
build/
dist/
wheelhouse/
.coverage
coverage.xml
htmlcov/

# --- Runtime data / artifacts (regenerated by the running stack) ---
*.log
logs/
*.pid
*.pid.lock
nohup.out
backend/nohup.out
backend/scans/
backend/reports/
backend/quarantine/
backend/evidence/
backend/mobsf_service/data/
telemetry/raw/*
!telemetry/raw/**/.gitkeep
scans/*.json

# --- Databases / SQLite sidecars ---
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# --- Frontend / Node ---
node_modules/
*.tsbuildinfo
.eslintcache
.parcel-cache/
.turbo/
.next/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp

# --- Claude Code / local agent runtime ---
.claude/
