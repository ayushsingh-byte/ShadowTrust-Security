# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
wheelhouse/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Coverage
.coverage
coverage.xml
htmlcov/

# --- Environment / secrets ---
# Real settings never go in the repo. Copy the .env.example next to each one
# (setup.sh does this for the root file) and fill in your own values.
.env
.env.*
!.env.example
demo_keys.json
nohup.out
*.pem
*.key
*.p12
*.pfx

# --- Logs / runtime artifacts ---
*.log
logs/

# Common runtime scratch
*.pid
*.pid.lock

# --- Databases / local state ---
# The application database is MariaDB, running as the `db` container with its
# data in the db_data Docker volume — nothing DB-related lives in the repo now.
# Any stray *.db / SQLite sidecar files are leftovers and should not be committed.
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# Local scan outputs (runtime)
scans/*.json
backend/scans/
backend/reports/

# Stray duplicate env files (previously removed)

# --- Frontend / Node ---
node_modules/

# TypeScript / Node build caches
*.tsbuildinfo
.eslintcache
.parcel-cache/
.turbo/
.next/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Misc ---
*.swp
*.swo
*.tmp

# Malware analysis — quarantined samples & incident evidence, never committed
backend/quarantine/
backend/evidence/
backend/mobsf_service/data/uploads/

# Build/codex scratch, never committed
.codex-build/
.codex-finalizer/

# Analysis Lab seed filesystem — fake scenario content, must be tracked
!docker/analysis-seed/**

# --- Local-only artefacts ---
# UI backups taken before each redesign pass
.backup/
# Full database dump: holds accounts and captured data, and is over GitHub's 100 MB file limit
database/dump.sql
# Rotated honeypot logs (the live logs and the seed corpus are tracked, see telemetry/README.md)
telemetry/raw/*/*.json.*
# Finished video files (large; share them as a release asset instead)
deliverables/

# --- Launch video project (videos/) ---
# The brief, storyboard, compositions and recording tools are tracked.
# Footage, staged assets, renders, snapshots and tool caches are generated and large.
videos/*/capture/
videos/*/assets/
videos/*/renders/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/.thumbnails/
videos/*/.waveform-cache/
videos/*/.media/

# Legacy copy of the first landing page
Honeynet 2/

# Hosted copy of the public site, built by scripts/build_site.py
dist-site/
.vercel/
